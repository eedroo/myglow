# Neon — ligação com pooling (runtime)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/myglow?sslmode=require"
# Neon — ligação directa (migrations)
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/myglow?sslmode=require"
# Auth.js — gerar com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# IA — geração dos horóscopos, leituras e rituais (Fase 6). API da OpenAI ou compatível.
# Gemini (Google AI Studio): chave do AI Studio + OPENAI_BASE_URL abaixo + modelos gemini-* (ver `npm run ai:check`).
OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# Pedidos por minuto à IA (throttle do Inngest; por defeito 60). Plano gratuito do Gemini: usar um valor baixo, ex.: 8
# AI_REQUESTS_PER_MINUTE="8"
# Modelo pequeno/rápido: horóscopos e leituras diárias e semanais
OPENAI_MODEL_DAILY="gpt-4o-mini"
# Modelo maior: leituras mensais e rituais
OPENAI_MODEL_RICH="gpt-4o"

# Inngest — jobs de geração (cron e eventos). Em dev: npx inngest-cli@latest dev
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Só em desenvolvimento, com o dev server do Inngest a correr
# INNGEST_DEV="1"

# Upstash Redis — rate limit dos pedidos de conteúdo
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
