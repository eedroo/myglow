# Neon — ligação com pooling (runtime)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/myglow?sslmode=require"
# Neon — ligação directa (migrations)
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/myglow?sslmode=require"
# Auth.js — gerar com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# IA — geração dos horóscopos, leituras e rituais (Fase 6). API da OpenAI ou compatível.
# Gemini (Google AI Studio): chave do AI Studio + OPENAI_BASE_URL abaixo + modelos gemini-* (ver `npm run ai:check`).
OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# Pedidos por minuto à IA (throttle do Inngest; por defeito 60). Plano gratuito do Gemini: usar um valor baixo, ex.: 8
# AI_REQUESTS_PER_MINUTE="8"
# Modelo pequeno/rápido: horóscopos e leituras diárias e semanais
OPENAI_MODEL_DAILY="gpt-4o-mini"
# Modelo maior: leituras mensais e rituais
OPENAI_MODEL_RICH="gpt-4o"
# F14: modelo do Guia (relatório semanal/mensal a partir do diário). Vazio = OPENAI_MODEL_RICH
OPENAI_MODEL_GUIDE=""

# Inngest — jobs de geração (cron e eventos). Em dev: npx inngest-cli@latest dev
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Só em desenvolvimento, com o dev server do Inngest a correr
# INNGEST_DEV="1"

# Upstash Redis — rate limit dos pedidos de conteúdo
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Web Push — lembretes (Fase 7). Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ola@exemplo.com"

# Email transaccional (Fase 9) — Resend. Sem RESEND_API_KEY fora de produção, os emails ficam em memória e na consola.
RESEND_API_KEY=""
EMAIL_FROM="MYGLOW <ola@myglow.onda.work>"
# Caixa real que recebe as respostas aos emails
EMAIL_REPLY_TO="privacidade@onda.work"
# URL pública da app (links nos emails)
APP_URL="https://myglow.onda.work"
# Versões dos documentos legais: mudar pede re-aceitação a todos os utilizadores
LEGAL_TERMS_VERSION="2026-10"
LEGAL_PRIVACY_VERSION="2026-10"
# F14: versão do texto de consentimento do Guia (mudar pede novo consentimento a quem o activou)
GUIDE_CONSENT_VERSION="2026-11"

# Beta (Fase 10): selo e avisos de beta; registo por código de convite (vazio = aberto); destino do feedback
BETA="true"
BETA_INVITE_CODES=""
FEEDBACK_EMAIL="privacidade@onda.work"
# Fase 12: administração (/admin): emails com acesso, separados por vírgulas (vazio = ninguém)
ADMIN_EMAILS=""
# Sentry (erros; projecto na região UE). Vazio = desligado. O token só no Vercel (upload de source maps no build)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Cópias de segurança: estes três ficam só nos segredos do GitHub Actions (ver docs/RUNBOOK.md), nunca aqui
# BACKUP_DATABASE_URL, BACKUP_PASSPHRASE, RESTORE_TEST_DATABASE_URL

# F16: imagens dos exercícios no Vercel Blob (só para scripts/fitness/import-images.ts; não é preciso em runtime)
BLOB_READ_WRITE_TOKEN=""
