generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ThemePref {
  LIGHT
  DARK
  SYSTEM
}

enum Hemisphere {
  NORTH
  SOUTH
}

enum Locale {
  PT_PT
  PT_BR
  EN
}

enum ProjectArea {
  MAGIC
  PERSONAL
  LEISURE
  PROFESSIONAL
  STUDIES
}

/// Pronomes / género gramatical usado nos textos pessoais gerados (NEUTRAL = linguagem neutra).
enum Pronouns {
  FEMININE
  MASCULINE
  NEUTRAL
}

enum PeriodKind {
  WEEK
  MONTH
  YEAR
}

enum MoonPhase {
  NEW_MOON
  WAXING_CRESCENT
  FIRST_QUARTER
  WAXING_GIBBOUS
  FULL_MOON
  WANING_GIBBOUS
  LAST_QUARTER
  WANING_CRESCENT
}

enum ZodiacSign {
  ARIES
  TAURUS
  GEMINI
  CANCER
  LEO
  VIRGO
  LIBRA
  SCORPIO
  SAGITTARIUS
  CAPRICORN
  AQUARIUS
  PISCES
}

enum XpSource {
  DAY_MORNING
  DAY_BODY
  DAY_NIGHT
  DAY_COMPLETE
  WEEK_PLAN
  WEEK_REFLECTION
  MONTH_PLAN
  MONTH_REFLECTION
  YEAR_PLAN
  STREAK_BONUS
  YEAR_REFLECTION
  COURSE_COMPLETE // Grimório (F8): curso concluído, sem janela; refId = slug do curso
}

enum SignContentKind {
  DAY_HOROSCOPE
  WEEK_ENERGY
  MONTH_ENERGY
}

enum UserContentKind {
  DAY_PERSONAL
  WEEK_PERSONAL
  MONTH_PERSONAL
  MONTH_RITUALS
}

// F12: plano e interruptores (sem pagamentos ainda)
enum Plan {
  FREE
  PREMIUM
}

enum PlanSource {
  MANUAL
  GIFT
  PAID // para quando houver pagamentos
}

enum FeatureRollout {
  HIDDEN
  PREMIUM
  ALL
}

enum NotificationKind {
  MORNING
  BODY
  NIGHT
  WEEK_START
  WEEK_END
  MONTH_START
  MONTH_END
  // Última chamada: só se o convite não foi seguido, perto do fim da janela do Glow
  WEEK_PLAN_LAST
  WEEK_REFLECTION_LAST
  MONTH_PLAN_LAST
  MONTH_REFLECTION_LAST
  // Grimório: convite de manhã (lições do dia liberadas) e última chamada à noite (lições por fazer)
  GRIMOIRE
  GRIMOIRE_LAST
  // F15: amigos (periodKey = id do pedido + instante do envio)
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  // F16: fim do descanso numa sessão de treino (só push; periodKey = sessionId:restEndsAt)
  REST_DONE
  // F17: lembrete de pesagem (só se ainda não há registo hoje; periodKey = dia local)
  WEIGH_IN
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  name             String
  locale           Locale     @default(PT_PT)
  theme            ThemePref  @default(LIGHT)
  timezone         String     @default("Europe/Lisbon")
  sleepGoalMinutes Int        @default(420)
  hemisphere       Hemisphere @default(NORTH)
  xpTotal          Int        @default(0)
  levelSeen        Int        @default(1) // último nível cujo diálogo de subida o user já viu
  bestMagicStreak  Int        @default(0)
  lastActiveAt     DateTime?
  aiUseIntentions  Boolean    @default(true) // sem uso: desde a F6 as intenções não vão para a IA (reservado para uma futura área de insights)
  pronouns         Pronouns   @default(NEUTRAL)
  onboardedAt      DateTime?
  // F9: conta, sessões e consentimentos
  emailVerifiedAt    DateTime?
  sessionVersion     Int        @default(0) // incrementar invalida todos os JWT
  termsAcceptedAt    DateTime?
  termsVersion       String? // ex.: "2026-10"
  privacyVersion     String?
  wellbeingConsentAt DateTime? // consentimento explícito para dados de bem-estar (humor, sono, peso)
  // F10: boas-vindas e beta
  welcomeSeenAt         DateTime?
  // F11: guia interactivo (welcomeSeenAt fica por compatibilidade, já não entra no fluxo)
  tourStep        String? // id do passo actual; null = não começou
  tourStartedAt   DateTime?
  tourCompletedAt DateTime?
  tourPausedAt    DateTime?
  firstStepsDismissedAt DateTime?
  inviteCode            String? // código de convite usado no registo
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  birthProfile      BirthProfile?
  notificationPrefs NotificationPrefs?
  dailyEntries      DailyEntry[]
  weeks             Week[]
  months            Month[]
  years             Year[]
  projectIntentions ProjectIntention[]
  xpEvents          XpEvent[]
  lessonProgress    LessonProgress[]
  courseProgress    CourseProgress[]
  reviewItems       ReviewItem[]
  announcementsSeen AnnouncementSeen[]
  userAiContent     UserAiContent[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
  authTokens        AuthToken[]
  feedback          Feedback[]
  // F12: plano (lido do servidor por pedido, nunca no JWT), actividade diária e excepções por funcionalidade
  plan              Plan        @default(FREE)
  planSource        PlanSource?
  planSince         DateTime?
  planExpiresAt     DateTime? // null = sem fim
  premiumInterestAt DateTime? // tocou em "Quero saber quando abrir"
  activeDays        UserActiveDay[]
  featureOverrides  FeatureOverride[]
  recapViews        RecapView[]
  // F14: Guia (premium), com consentimento próprio, desligado por defeito
  guideConsentAt      DateTime?
  guideConsentVersion String? // versão do texto de consentimento aceite
  guideReports        GuideReport[]
  // F15: amigos (só mútuos). Código do link gerado na base (mg_friend_code), regenerável; @ escolhido pela pessoa.
  friendCode       String          @unique @default(dbgenerated("mg_friend_code()"))
  handle           String?         @unique // @ sem o arroba, em minúsculas
  showBigThree     Boolean         @default(false) // Sol, Lua e Ascendente visíveis aos amigos
  invitedById      String? // quem convidou (link de amigo), para métricas
  sentRequests     FriendRequest[] @relation("sent")
  receivedRequests FriendRequest[] @relation("received")
  friendshipsA     Friendship[]    @relation("a")
  friendshipsB     Friendship[]    @relation("b")
  blocks           UserBlock[]     @relation("blocker")
  blockedBy        UserBlock[]     @relation("blocked")
  // F16: Foco no corpo (premium)
  fitnessPrefs     FitnessPrefs?
  customExercises  Exercise[]
  fitnessPrograms  FitnessProgram[]
  fitnessSessions  FitnessSession[]
  // F17: peso diário, objectivo e o Guia a ler o corpo (autorização própria)
  bodyWeights      BodyWeightEntry[]
  bodyGoal         BodyGoal?
  guideIncludeBody Boolean           @default(false)
  // F18: modo guiado
  guidedRuns       GuidedRun[]
  guidedAutoOpen   Boolean           @default(false) // abrir o fluxo sugerido ao entrar no Hoje (uma vez por fluxo e dia)
}

enum FeedbackKind {
  BUG
  IDEA
  PRAISE
  OTHER
}

// Feedback do beta (F10): gravado e enviado por email; fica mesmo que a conta seja apagada (sem utilizador).
model Feedback {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      FeedbackKind
  message   String
  path      String? // página de onde foi enviado
  userAgent String?
  locale    String?
  createdAt DateTime     @default(now())
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
}

// Tokens de email (confirmação, recuperação, alteração): só o hash SHA-256; uso único; com expiração.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  newEmail  String? // só EMAIL_CHANGE
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model BirthProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate       DateTime  @db.Date // data local de nascimento
  birthTime       String? // "HH:mm" local; null = hora desconhecida
  birthTimeKnown  Boolean // false → mapa sem ascendente nem casas
  placeName       String
  latitude        Float
  longitude       Float
  timezone        String // IANA do local de nascimento
  birthUtc        DateTime // instante em UTC (Luxon, fuso histórico); se hora desconhecida usa 12:00 local
  natalChart      Json? // preenchido na Fase 2
  chartComputedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DailyEntry {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime   @db.Date
  moonPhase         MoonPhase
  moonSign          ZodiacSign
  intention         String?
  morningBanishName String?
  morningBanishDone Boolean    @default(false)
  morningRitualDone Boolean    @default(false)
  sleepGoalMet      Boolean    @default(false)
  wakeMood          Int? // 1–5
  wakeNote          String?
  stretchDone       Boolean    @default(false)
  workoutDone       Boolean    @default(false)
  waterDone         Boolean    @default(false)
  nightBanishName   String?
  nightBanishDone   Boolean    @default(false)
  nightRitualDone   Boolean    @default(false)
  gratitude         String?
  mood              Int? // 1–5
  reflection        String?
  summary           String?
  readingChoice     ReadingChoice? // F18: leitura do dia agora ou à noite (pergunta diária)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([userId, date])
}

/// F18: quando a pessoa quer ver a leitura do dia.
enum ReadingChoice {
  NOW
  NIGHT
}

model Week {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime      @db.Date // sempre um domingo
  year        Int // ano do domingo
  month       Int // 1–12, mês do domingo
  weekOfMonth Int // 1..5
  title       String?
  intention   String?
  weightGrams Int?
  reflection  String?
  dayNotes    WeekDayNote[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, startDate])
}

model WeekDayNote {
  id     String   @id @default(cuid())
  weekId String
  week   Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  text   String

  @@unique([weekId, date])
}

model Month {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  intention  String?
  reflection String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, year, month])
}

model Year {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year       Int
  word       String?
  intention  String?
  reflection String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, year])
}

model ProjectIntention {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      PeriodKind
  periodStart DateTime    @db.Date // domingo da semana, dia 1 do mês, 1 jan do ano
  area        ProjectArea
  text        String
  updatedAt   DateTime    @updatedAt

  @@unique([userId, period, periodStart, area])
}

model XpEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      XpSource
  periodStart DateTime @db.Date
  points      Int
  refId       String   @default("") // F8: distingue eventos da mesma fonte no mesmo dia (ex.: slug do curso)
  createdAt   DateTime @default(now())

  @@unique([userId, source, periodStart, refId])
}

// Novidades: o que cada utilizador já viu no pop-up "Novidades MYGLOW" ("release:<id>" ou "course:<slug>").
model AnnouncementSeen {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  seenAt DateTime @default(now())

  @@unique([userId, key])
}

// Grimório (F8): progresso na trilha de conhecimento. O conteúdo vive em content/grimoire (ficheiros).
model LessonProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug    String
  lessonSlug    String
  completedAt   DateTime @default(now())
  completedDate DateTime @db.Date // dia local — usado no limite diário

  @@unique([userId, courseSlug, lessonSlug])
  @@index([userId, completedDate])
}

model CourseProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug   String
  startedAt    DateTime  @default(now())
  quizAttempts Int       @default(0)
  bestScore    Int?
  completedAt  DateTime? // lições todas + quiz ≥ 4/5 → emblema

  @@unique([userId, courseSlug])
}

model ReviewItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug String
  lessonSlug String
  questionId String
  dueDate    DateTime @db.Date
  box        Int      @default(0) // Leitner: 0→1 dia, 1→3, 2→7, 3→21, 4→60

  @@unique([userId, courseSlug, lessonSlug, questionId])
  @@index([userId, dueDate])
}

// Conteúdo partilhado por signo (gerado 1x por signo/período/língua)
model SignContent {
  id            String          @id @default(cuid())
  kind          SignContentKind
  periodStart   DateTime        @db.Date
  sign          ZodiacSign
  locale        Locale
  payload       Json
  model         String
  promptVersion Int             @default(1)
  createdAt     DateTime        @default(now())

  @@unique([kind, periodStart, sign, locale])
}

// Camada personalizada por utilizador
model UserAiContent {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          UserContentKind
  periodStart   DateTime        @db.Date
  locale        Locale
  payload       Json
  model         String
  promptVersion Int             @default(1)
  createdAt     DateTime        @default(now())

  @@unique([userId, kind, periodStart, locale])
}

model NotificationPrefs {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled     Boolean @default(true)
  morningTime String  @default("08:00")
  bodyTime    String  @default("13:00")
  nightTime   String  @default("21:30")
  weekStart   Boolean @default(true)
  weekEnd     Boolean @default(true)
  monthStart  Boolean @default(true)
  monthEnd    Boolean @default(true)
  // F7: lembretes diários individuais; horários só em múltiplos de 15 min ("HH:00|15|30|45")
  morningEnabled Boolean @default(true)
  bodyEnabled    Boolean @default(true)
  nightEnabled   Boolean @default(true)
  lastCall       Boolean @default(true) // avisos de última chamada (plano/reflexão da semana e do mês)
  grimoireEnabled Boolean @default(true) // convite do Grimório (a última chamada depende também de lastCall)
  grimoireTime    String  @default("10:00")
  friends         Boolean @default(true) // F15: pedidos e aceitações de amizade (push; a caixa recebe sempre)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model NotificationLog {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  periodKey String // "2026-05-06" (dia), "W2026-05-03" (semana, domingo), "M2026-05" (mês)
  sentAt    DateTime         @default(now())
  // F7: conteúdo do aviso (caixa de avisos na app) e estado
  title     String
  body      String
  url       String
  pushed    Boolean          @default(false) // enviado por push com sucesso a ≥ 1 dispositivo
  readAt    DateTime?
  clearedAt DateTime? // "Limpar" na caixa de avisos: some da caixa, mas o registo fica (evita reenvios)

  @@unique([userId, kind, periodKey])
  @@index([userId, sentAt])
}

// F12: um registo por dia em que a pessoa abriu a app (DAU/WAU/MAU e retenção)
model UserActiveDay {
  userId String
  day    DateTime @db.Date // data no fuso do utilizador
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

// F12: estado global de cada funcionalidade (sem linha = valor por defeito do código)
model FeatureFlag {
  key       String         @id
  rollout   FeatureRollout
  updatedAt DateTime       @updatedAt
}

// F12: excepção por pessoa
model FeatureOverride {
  userId    String
  key       String
  enabled   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

// F13: retrospectiva vista (e concluída) por período
enum RecapKind {
  WEEK
  MONTH
}

model RecapView {
  userId      String
  kind        RecapKind
  periodKey   String // WEEK: 'YYYY-MM-DD' (domingo) · MONTH: 'YYYY-MM'
  firstSeenAt DateTime  @default(now())
  completedAt DateTime? // chegou ao último slide
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, periodKey])
  @@index([firstSeenAt])
}

// F14: leitura do Guia (semanal ou mensal) a partir do diário; uma por período
enum GuideStatus {
  READY
  INSUFFICIENT
  SUPPORT
  FAILED
}

model GuideReport {
  id            String      @id @default(cuid())
  userId        String
  kind          RecapKind // WEEK | MONTH
  periodKey     String // 'YYYY-MM-DD' (domingo) | 'YYYY-MM'
  locale        String
  status        GuideStatus
  payload       Json? // GuideReportPayload validado (READY); null nos outros
  model         String?
  promptVersion Int         @default(1)
  inputHash     String? // sha256 do input já limpo; evita regenerar igual
  inputTokens   Int?
  outputTokens  Int?
  regenerations Int         @default(0) // máx. 1 por período
  generatedAt   DateTime    @default(now())
  readAt        DateTime?
  rating        Int? // 1 = ajudou, -1 = não ajudou
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey])
  @@index([userId, generatedAt])
  @@index([generatedAt])
}

// F15: amigos
enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

model FriendRequest {
  id          String              @id @default(cuid())
  fromId      String
  toId        String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  from        User                @relation("sent", fields: [fromId], references: [id], onDelete: Cascade)
  to          User                @relation("received", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId]) // reenvio reutiliza a linha
  @@index([toId, status])
  @@index([status, createdAt])
}

// Um registo por par; userAId < userBId
model Friendship {
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("a", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("b", fields: [userBId], references: [id], onDelete: Cascade)

  @@id([userAId, userBId])
  @@index([userBId])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// F16: Foco no corpo (treinos e sessões)
enum ExerciseSource {
  LIBRARY
  CUSTOM
}

enum ExerciseMeasure {
  REPS_WEIGHT // kg + reps
  REPS // só reps (peso corporal)
  DURATION // tempo
}

enum ProgramKind {
  STRENGTH
  STRETCH
  MIXED
}

model Exercise {
  id               String          @id // LIBRARY: id da free-exercise-db; CUSTOM: cuid
  source           ExerciseSource
  ownerId          String? // só CUSTOM
  names            Json // { en, "pt-PT", "pt-BR" }
  category         String
  measure          ExerciseMeasure
  primaryMuscles   String[]
  secondaryMuscles String[]
  equipment        String?
  level            String?
  instructions     Json? // { en: string[], "pt-PT"?: string[], "pt-BR"?: string[] }
  images           String[] // URLs no Vercel Blob
  defaultRestSec   Int?
  archivedAt       DateTime?
  owner            User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workoutItems     WorkoutItem[]
  sets             SessionSet[]

  @@index([ownerId])
}

model FitnessPrefs {
  userId         String    @id
  defaultRestSec Int       @default(90)
  restAlert      Boolean   @default(true) // aviso de fim de descanso
  keepAwake      Boolean   @default(true) // manter o ecrã ligado durante o treino
  weighInReminder Boolean  @default(false) // F17: lembrete de pesagem
  weighInTime     String   @default("08:00")
  onboardedAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FitnessProgram {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  kind        ProgramKind      @default(STRENGTH)
  order       Int
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  workouts    FitnessWorkout[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FitnessWorkout {
  id         String           @id @default(cuid())
  programId  String
  userId     String
  name       String
  notes      String?
  order      Int
  archivedAt DateTime?
  items      WorkoutItem[]
  sessions   FitnessSession[]
  program    FitnessProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkoutItem {
  id            String         @id @default(cuid())
  workoutId     String
  exerciseId    String
  order         Int
  targetSets    Int?
  targetRepsMin Int?
  targetRepsMax Int?
  targetSec     Int? // exercícios DURATION
  restSec       Int? // sobrepõe o descanso por defeito
  notes         String?
  workout       FitnessWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
}

model FitnessSession {
  id             String          @id @default(cuid())
  userId         String
  workoutId      String? // null = treino livre
  date           DateTime        @db.Date // dia local do início
  startedAt      DateTime
  endedAt        DateTime?
  restEndsAt     DateTime? // descanso em curso
  restExerciseId String?
  clientHidden   Boolean         @default(false) // app em segundo plano (para decidir o push)
  extraExercises String[] // "+ Exercício" na sessão (não muda o treino guardado)
  notes          String?
  sets           SessionSet[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout        FitnessWorkout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
}

model SessionSet {
  id          String         @id @default(cuid())
  sessionId   String
  userId      String
  exerciseId  String
  order       Int
  reps        Int?
  weightGrams Int?
  durationSec Int?
  completedAt DateTime
  restSec     Int? // descanso usado depois desta série
  prKinds     String[]       @default([]) // F17: recordes batidos nesta série ('weight' | 'e1rm' | 'reps')
  session     FitnessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([userId, exerciseId, completedAt])
  @@index([sessionId])
}

// ─── F17: Corpo II (peso diário e objectivo) ─────────────────────────────────────────────────────

enum BodyGoalDirection {
  GAIN
  MAINTAIN
  LOSE
}

model BodyWeightEntry {
  userId    String
  date      DateTime @db.Date // dia local; 1 registo por dia (o último substitui)
  grams     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

model BodyGoal {
  userId          String            @id
  direction       BodyGoalDirection
  weeklyRateGrams Int // valor absoluto; MAINTAIN = 0
  targetGrams     Int?
  startGrams      Int // média da semana em que o objectivo foi criado
  startedAt       DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── F18: Modo guiado ────────────────────────────────────────────────────────────────────────────

enum GuidedFlow {
  DAY_MORNING
  DAY_BODY
  DAY_NIGHT
  WEEK_PLAN
  WEEK_CLOSE
  MONTH_PLAN
  MONTH_CLOSE
  YEAR_PLAN
  YEAR_CLOSE
}

model GuidedRun {
  userId      String
  flow        GuidedFlow
  periodKey   String // DAY_*: 'YYYY-MM-DD' · WEEK_*: domingo · MONTH_*: 'YYYY-MM' · YEAR_*: 'YYYY'
  startedAt   DateTime   @default(now())
  completedAt DateTime? // chegou ao último ecrã
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, flow, periodKey])
}
